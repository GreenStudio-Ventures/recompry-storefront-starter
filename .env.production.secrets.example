# ─── Secretos de PRODUCCIÓN del Worker ───────────────────────────────────────
# Copia a `.env.production.secrets` (gitignored) con keys LIVE y súbelo con
# `npm run cf:secrets:bulk` (= wrangler secret bulk .env.production.secrets).
#
# SOLO secretos. NUNCA pongas aquí variables NEXT_PUBLIC_* (p.ej. NEXT_PUBLIC_RECOMPRY_API_URL):
# ya existen como `vars` en wrangler.jsonc y `secret bulk` fallaría por binding duplicado
# (Cloudflare rechaza el mismo nombre como var y como secreto, y no sube NINGÚN secreto).

# rcp_pk_live_… (lecturas públicas)
RECOMPRY_PUBLISHABLE_KEY=rcp_pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# rcp_sk_live_… con todos los :read + orders:write, customers:write, payments:write, subscriptions:write
RECOMPRY_SECRET_KEY=rcp_sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# whsec_… del endpoint (POST /v1/webhook-endpoints) o de la Automatización. Omite si no recibes webhooks.
RECOMPRY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
